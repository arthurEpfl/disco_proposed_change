{
  "name": "epfl-antibiogo-lib",
  "private": true,
  "browser": "/dist/browser/disco.js",
  "main": "./dist/node/disco.js",
  "types": "./dist/node/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "rm -rf dist/node && webpack --config-name node-dev",
    "build:web": "rm -rf dist/browser && webpack --config-name web-dev",
    "prod:node": "rm -rf dist/node && webpack --config-name node-prod",
    "prod:web": "rm -rf dist/browser && webpack --config-name web-prod",
    "lint": "eslint --fix --max-warnings 0 .",
    "build:all": "npm run build && npm run prod:node && npm run prod:web",
    "test": "mocha",
    "test:aggregation": "mocha --require esm --reporter spec 'src/core/weights/aggregation.spec.ts'",
    "test:fit_new": "mocha --require esm --reporter spec 'test_1new_spec.ts'",
    "test:fit_second": "mocha --require esm --reporter spec 'test_1new_spec2.ts'",
    "test:fit_multiple": "mocha --require esm --reporter spec 'test_multiple_spec.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epfml/disco.git"
  },
  "bugs": {
    "url": "https://github.com/epfml/disco/issues"
  },
  "homepage": "https://github.com/epfml/disco#readme",
  "dependencies": {
    "@koush/wrtc": "0.5",
    "@tensorflow/tfjs": "4",
    "@types/chai": "^5.0.1",
    "@types/msgpack-lite": "0.1",
    "axios": "^1.2.1",
    "chai": "^5.1.2",
    "disco": "github:epfml/disco#develop",
    "immutable": "4.1",
    "isomorphic-ws": "4",
    "msgpack-lite": "0.1",
    "simple-peer": "9",
    "tslib": "2",
    "url": "0.11",
    "uuid": "8",
    "ws": "8"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@tensorflow/tfjs-node": "4",
    "@types/mocha": "^10.0.0",
    "@types/simple-peer": "9",
    "@types/uuid": "8",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "crypto-browserify": "3",
    "eslint": "8",
    "eslint-config-standard-with-typescript": "^22.0.0",
    "esm": "^3.2.25",
    "mocha": "^11.0.1",
    "mock-require": "^3.0.3",
    "path-browserify": "1",
    "proxyquire": "^2.1.3",
    "querystring-es3": "0.2",
    "stream-browserify": "3",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.8.0",
    "webpack": "5",
    "webpack-cli": "4",
    "webpack-node-externals": "^3.0.0"
  }
}
