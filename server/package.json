{
  "name": "@epfml/disco-server",
  "version": "2.1.1",
  "main": "dist/index.js",
  "bin": {
    "disco-server": "./dist/run_server.js"
  },
  "type": "module",
  "scripts": {
    "dev": "nodemon src/run_server.ts",
    "start": "ts-node src/run_server.ts",
    "build": "tsc",
    "clean": "tsc --build --clean && rm -r dist || true",
    "test": "mocha --exit -r ts-node/register 'tests/**/*.ts'",
    "lint": "npx eslint --max-warnings 0 .",
    "server": "npx tsx src/run_server.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@koush/wrtc": "0.5",
    "@tensorflow/tfjs": "4",
    "axios": "^1.2.1",
    "cors": "2",
    "epfl-antibiogo-lib": "file:../discojs",
    "express": "4",
    "express-ws": "5",
    "immutable": "4.1",
    "isomorphic-wrtc": "^1.0.4",
    "lodash": "4",
    "ml-pca": "^4.1.1",
    "msgpack-lite": "0.1",
    "sharp": "^0.33.5"
  },
  "nodemonConfig": {
    "ignore": [
      "dist/*",
      "models/*"
    ],
    "execMap": {
      "ts": "node --inspect=0.0.0.0:9229 --nolazy -r ts-node/register"
    }
  },
  "devDependencies": {
    "@types/chai": "4",
    "@tensorflow/tfjs-node": "4",
    "@types/cors": "2",
    "@types/express-ws": "3",
    "@types/mocha": "9",
    "@types/msgpack-lite": "0.1",
    "@types/node": "^18.7.18",
    "@types/supertest": "2",
    "@typescript-eslint/eslint-plugin": "4",
    "@typescript-eslint/parser": "4",
    "chai": "4",
    "eslint": "7",
    "eslint-config-standard-with-typescript": "21",
    "eslint-plugin-import": "2",
    "eslint-plugin-node": "11",
    "eslint-plugin-promise": "5",
    "mocha": "9",
    "nodemon": "2",
    "supertest": "6",
    "ts-node": "^10.9.2",
    "ts-node-register": "1",
    "tsx": "^4.19.2",
    "typescript": "^4.9.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epfml/disco.git"
  },
  "bugs": {
    "url": "https://github.com/epfml/disco/issues"
  },
  "homepage": "https://github.com/epfml/disco#readme"
}
